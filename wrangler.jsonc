{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "max",
  "main": "src.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "CERT_BUCKET",
      "bucket_name": "cinemamax-certificates"
    }
  ]
}
